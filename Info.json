{
  "name": "VR2D",
  "identifier": "io.github.fetzu.vr2d",
  "version": "1.0.0",
  "description": "Watch 3D VR videos (180°/360°, side-by-side or over-under, equirectangular or fisheye) as a flat 2D image you can pan and zoom. Detects VR sources automatically from file names and container metadata.",
  "author": {
    "name": "fetzu",
    "url": "https://github.com/fetzu"
  },
  "ghRepo": "fetzu/iina-plugin-vr2d",
  "ghVersion": 1,
  "entry": "src/index.js",
  "permissions": [
    "show-osd",
    "video-overlay"
  ],
  "preferencesPage": "ui/preferences.html",
  "preferenceDefaults": {
    "autoEnable": true,
    "aggressiveDetection": false,
    "dragToPan": true,
    "showHud": true,
    "invertDrag": false,
    "fieldOfView": 105,
    "quality": 0,
    "interp": "cubic",
    "updateRate": 0,
    "dragSensitivity": 1,
    "keyStep": 35,
    "eye": "left",
    "bottomSafeArea": 120,
    "topSafeArea": 56
  }
}
